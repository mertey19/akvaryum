NEXT_PUBLIC_DEMO_MODE=true
# Canonical site address. On Vercel the production domain is used when empty.
SITE_URL=
# Set to false to keep search engines out even when a site address is known.
ALLOW_INDEXING=
# Admin panel password for /yonetim (required to log in).
ADMIN_PASSWORD=
# Optional separate secret for signing admin sessions; derived from the password when empty.
ADMIN_SESSION_SECRET=
# Added by Vercel when Neon and Blob are connected; leave empty locally to use .data/.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# Newer Blob stores are connected with a store id and the deployment's OIDC token instead.
BLOB_STORE_ID=
